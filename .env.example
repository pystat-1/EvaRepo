# Postgres connection string (Neon in production). Get this from your Neon
# project's dashboard — typically the pooled ("-pooler") connection string
# for serverless/Vercel use.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Required. The app throws at startup if this is missing — there is no
# hardcoded fallback secret (see plan §2.1 for why that matters).
JWT_SECRET="replace-with-a-long-random-value"
