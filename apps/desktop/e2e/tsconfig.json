{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@eva/core/*": ["../../../packages/core/src/*"],
      "@eva/db/*": ["../../../packages/db/src/*"]
    }
  },
  "include": ["."]
}
