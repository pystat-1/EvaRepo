{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2023", "webworker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "paths": { "@eva/core/*": ["../../packages/core/src/*"] }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
