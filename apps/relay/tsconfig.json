{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    "paths": { "@eva/core/*": ["../../packages/core/src/*"] }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
