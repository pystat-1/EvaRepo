{"nodes": [{"id": "readme_eva_v3", "label": "Eva v3 Project", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_phase1_registry", "label": "Phase 1: Registry (Students, Groups, Hospitals, Study Types)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_phase2_evaluators", "label": "Phase 2: Evaluators", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_phase3_grading", "label": "Phase 3: Grading System", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_stack", "label": "Tech Stack (Next.js, TypeScript, Tailwind, bcrypt, JWT)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_prisma_migration", "label": "Prisma + Postgres (Neon) Database Layer", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces a prior node:sqlite raw-SQL layer that existed only because the Phase 1-3 dev sandbox blocked outbound access to binaries.prisma.sh, which `prisma generate` needs to fetch its query-engine binary. Deploying to Vercel + Neon removes that restriction, so the raw-SQL layer was retired for real Prisma. Honesty note: since the same sandbox still blocks binaries.prisma.sh, @prisma/client in that environment only ever contains its un-generated stub (PrismaClient and model types collapse to `any`), so `npx tsc --noEmit` passing there is not proof of correctness against the real generated client -- the first real `prisma generate` happens automatically on Vercel's build via the `postinstall` script, and `tsc --noEmit` should be re-run right after."}, {"id": "readme_tier0_bug_fix", "label": "Tier 0 Data-Loss Bug Fix", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed structurally, not patched: the unit of write is one row per student per day (`evaluations`, UNIQUE(studentId, dateISO) in src/lib/db.ts) instead of a whole day's session object, so two evaluators grading two different students on the same day write independent rows that cannot collide."}, {"id": "readme_flags_engine", "label": "Flags Engine (at-risk detection)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rubric", "label": "Grading Rubric", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_evaluator_scoping", "label": "Evaluator Scoping (server-side)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_student_portal", "label": "/me Student Self-Service Portal", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_smoke_tests", "label": "Smoke Test Scripts", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_known_gaps", "label": "Known Gaps", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately deferred items: no change/forgot-password UI, no pagination at class-roster scale, grading hardcoded to today's date (backdating would invite abuse without an admin override), rubric sections can be deactivated but not deleted so historical scores keep their label, no offline/PWA support yet, and no automated test suite in CI (smoke-test scripts are manual Playwright checks, not idempotent against each other's fixture data)."}, {"id": "readme_jwt_secret_requirement", "label": "JWT_SECRET Required at Startup", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app throws at startup if JWT_SECRET is missing rather than falling back to a default, because a missing-secret fallback was a real bug found in a sibling project during an earlier audit; this app is written specifically not to repeat it."}], "edges": [{"source": "readme_eva_v3", "target": "readme_phase1_registry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_eva_v3", "target": "readme_phase2_evaluators", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_eva_v3", "target": "readme_phase3_grading", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_eva_v3", "target": "readme_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_stack", "target": "readme_prisma_migration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.