{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "evarepo",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Run the Worker next to the Neon database (AWS us-west-2) instead of at
  // the edge nearest the user. Every page and every grade save makes many
  // sequential database round trips; from the edge each one cost ~270 ms
  // (a single autosave took several seconds), next to the database each
  // is a few ms. The user pays the long hop once per request instead.
  "placement": {
    "region": "aws:us-west-2"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Without this, Cloudflare serves any request whose path matches a
    // static asset (e.g. /login, which Next.js prerendered as static
    // HTML) directly from the assets layer — for every HTTP method,
    // including the POST a Server Action form submits — and never
    // invokes the Worker at all, so a login POST to /login 404'd instead
    // of ever reaching Next.js. Routing every request through the Worker
    // first (it serves static assets itself via the ASSETS binding when
    // appropriate) fixes that at a negligible cost for an app this size.
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "evarepo"
    }
  ]
}
